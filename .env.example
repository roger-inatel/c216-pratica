# Copie para .env e ajuste se precisar (o .env nao vai para o Git).
# O docker-compose.yml tem valor padrao para todas estas variaveis,
# entao o projeto tambem sobe sem .env.

# Banco de dados. Em producao, troque a senha por uma de verdade.
POSTGRES_USER=entregas
POSTGRES_PASSWORD=entregas
POSTGRES_DB=entregas
POSTGRES_PORT=5432

BACKEND_PORT=8000
FRONTEND_PORT=5173

# Endereco da API que o navegador chama. Entra no build da imagem do frontend:
# depois de mudar, rode make up-build.
VITE_API_URL=http://localhost:8000

# Origens que a API aceita no CORS, separadas por virgula. Precisa bater com o
# endereco do frontend (FRONTEND_PORT). Nao use "*".
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# So para rodar o Alembic fora do container, contra a porta publicada do banco:
# DATABASE_URL=postgresql+psycopg://entregas:entregas@localhost:5432/entregas
