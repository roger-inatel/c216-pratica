# Copie para .env e ajuste se precisar.
# O docker-compose.yml tem valores padrao para todas estas variaveis,
# entao o projeto sobe sem .env nenhum.

POSTGRES_USER=c216
POSTGRES_PASSWORD=c216
POSTGRES_DB=c216
POSTGRES_PORT=5432

BACKEND_PORT=8000
FRONTEND_PORT=5173

# O navegador chama a API pela porta publicada do backend. A URL entra no build
# da imagem do frontend: depois de mudar, rode make docker-rebuild.
VITE_API_URL=http://localhost:8000

# Origens que o backend aceita no CORS, separadas por virgula. Precisa bater com
# o endereco do frontend (FRONTEND_PORT). Nao use "*".
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# O Compose monta a DATABASE_URL a partir das variaveis acima e entrega ao backend.
# Defina-a apenas para rodar o Alembic fora do container, contra a porta publicada:
# DATABASE_URL=postgresql+psycopg://c216:c216@localhost:5432/c216
